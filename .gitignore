# ================================
# RUST PROJECT PATTERNS
# ================================

# Rust build artifacts
**/target/
**/Cargo.lock
# Keep Cargo.lock for applications, but ignore for libraries
# Uncomment below if this is a library crate:
# **/Cargo.lock

# Generated by cargo
# will have compiled files and executables
debug/
target/

# Generated by Rust/cargo
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated contract bindings (can be regenerated)
**/src/*_verification.rs
**/src/identity_verification.rs

