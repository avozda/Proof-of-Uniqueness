# SOLIDITY/FOUNDRY PATTERNS  
# ================================

# Foundry artifacts
**/cache/
**/out/
**/broadcast/
**/artifacts/
**/typechain-types/

# Gas snapshots
.gas-snapshot

# Environment variables
.env

# ================================
# CIRCOM/ZK PATTERNS
# ================================

# Zero-knowledge artifacts
src/circuits/build/

# Keep important zk files but ignore intermediate ones
# Uncomment specific files you want to keep:
# !**/final.zkey
# !**/verification_key.json

# Generated witness files  
**/witness.wtns
**/input.json
**/public.json

# Circom build directories
**/build/
**/circuits/build/

